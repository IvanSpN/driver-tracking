# Переменные для docker compose на сервере: cp .env.example .env и заполнить

# Домен, направленный A-записью на сервер, — Caddy сам получит HTTPS.
# Без домена: SITE_ADDRESS=:80 и COOKIE_SECURE=false (иначе логин не сохранится)
SITE_ADDRESS=drivers.example.kz
COOKIE_SECURE=true

DB_USER=driver
DB_PASSWORD=
DB_NAME=driver_tracking

# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d
