# Переменные для docker compose на сервере: cp .env.example .env и заполнить

# Домен, направленный A-записью на сервер, — Caddy сам получит HTTPS.
# Без домена: SITE_ADDRESS=:80 и COOKIE_SECURE=false (иначе логин не сохранится)
SITE_ADDRESS=drivers.example.kz
COOKIE_SECURE=true

# Порты на хосте. Если 80/443 заняты другим приложением — например 8080/8443
# (HTTPS с домен-сертификатом работает только на стандартных 80/443)
HTTP_PORT=80
HTTPS_PORT=443

DB_USER=driver
DB_PASSWORD=
DB_NAME=driver_tracking

# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=30d
