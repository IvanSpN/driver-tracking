# SITE_ADDRESS = домен (Caddy сам выпустит HTTPS-сертификат) или :80 для HTTP по IP
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	# В именах файлов из /assets хеш сборки — их можно кэшировать навсегда.
	# Отдельный handle, чтобы несуществующий файл давал 404, а не index.html
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html браузер перепроверяет при каждом заходе (по ETag), иначе
	# Safari после деплоя часами показывает старую версию
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
